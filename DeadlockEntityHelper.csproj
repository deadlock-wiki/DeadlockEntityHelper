<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <Nullable>enable</Nullable>
        <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
        <Version>2.1.0</Version>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0-rc.2.26504.105" />
      <PackageReference Include="SteamKit2" Version="3.4.0" />
      <PackageReference Include="System.CommandLine" Version="3.0.0-rc.2.26504.105" />
      <PackageReference Include="ValvePak" Version="6.0.0.182" />
      <PackageReference Include="ValveResourceFormat" Version="20.0.6980" />
    </ItemGroup>

</Project>
